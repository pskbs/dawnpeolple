{
  "name": "dawnpeople",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:web": "tsc -b && vite build",
    "build:toss": "tsc -b && vite build --mode toss && ait build",
    "lint": "oxlint",
    "typecheck": "tsc -b --noEmit",
