# 이 파일을 복사해 .env(로컬 개발용)를 만드세요. 값을 채운 .env는 절대 커밋하지 마세요.

# --- 플랫폼/테마 스위치 ---
VITE_PLATFORM=web
VITE_THEME=hybrid

# --- Supabase (클라이언트에 노출되는 값만) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase 서버 전용 (api/ 서버리스 함수에서만 사용, 절대 VITE_ 접두사 붙이지 말 것) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- AI 필터 ---
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
AI_DAILY_LIMIT=200

# --- 토스 로그인 (Phase 2, PoC 이후 값 확정) ---
TOSS_APP_KEY=
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_DECRYPTION_KEY=
TOSS_MTLS_CERT_BASE64=
TOSS_MTLS_KEY_BASE64=

# --- 앱인토스 광고 (제공받은 테스트/운영 ID) ---
VITE_AD_BANNER_ID=
VITE_AD_INTERSTITIAL_ID=
