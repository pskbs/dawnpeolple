# 이 파일을 복사해 .env(로컬 개발용)를 만드세요. 값을 채운 .env는 절대 커밋하지 마세요.

# --- 플랫폼/테마 스위치 ---
VITE_PLATFORM=web
VITE_THEME=hybrid

# --- api/ 서버리스 함수 절대 URL(앱인토스 빌드 전용) ---
# 앱인토스 빌드(webBundleDir=dist)는 토스가 dist를 자체 호스팅해 페이지 origin이 Vercel과 달라져요.
# VITE_PLATFORM=toss로 빌드할 때는 배포된 Vercel URL(예: https://dawnpeople.vercel.app)을 반드시 채워야
# 토스 로그인 등 /api 호출이 실제 서버에 도달해요. web 빌드는 같은 origin이라 비워둬도 돼요.
VITE_API_BASE_URL=

# --- Supabase (클라이언트에 노출되는 값만) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase 서버 전용 (api/ 서버리스 함수에서만 사용, 절대 VITE_ 접두사 붙이지 말 것) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- 비밀번호 찾기 메일 발송 (api/auth/reset-password.ts, 서버 전용) ---
# Gmail: 2단계 인증을 켠 뒤 Google 계정 → 보안 → "앱 비밀번호"로 16자리 비밀번호를 만들어 SMTP_PASS에 넣어요.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=wol100st2@gmail.com
SMTP_PASS=
MAIL_FROM=wol100st2@gmail.com

# --- AI 필터 ---
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
AI_DAILY_LIMIT=200

# --- 토스 로그인 ---
# App Key/Client ID/Client Secret 같은 별도 인증 값은 없음(공식 문서로 확인, 2026-09-23) —
# 서버 간 인증은 mTLS 인증서만으로 끝남. docs/decisions.md 2026-09-23 참고.
# 콘솔 "이메일로 복호화 키 받기"로 받은 값
TOSS_DECRYPTION_KEY=
# 복호화 키와 별도로 콘솔에서 전달되는 AAD 값(로그인 사용자 정보 복호화에 필요)
TOSS_DECRYPT_AAD=
# 콘솔 "mTLS 인증서" 메뉴에서 발급받은 인증서/개인키 파일을 base64로 인코딩한 값
TOSS_MTLS_CERT_BASE64=
TOSS_MTLS_KEY_BASE64=

# --- 토스 로그인 "연결 끊기(UNLINK)" 콜백 (api/auth/toss/unlink.ts) ---
# 콘솔의 "연결 끊기 콜백 URL"에 https://<배포 도메인>/api/auth/toss/unlink 등록 + 이 값과 동일한
# Basic Auth를 콘솔에도 입력해야 위조 요청을 막을 수 있어요.
TOSS_UNLINK_CALLBACK_USER=
TOSS_UNLINK_CALLBACK_PASS=

# --- 토스 푸시(스마트 발송, api/push/dispatch.ts) ---
# 콘솔 → 스마트 발송 → 기능성 캠페인에서 문구 검수 승인 후 받은 발송 코드("dawnpeople-"로 시작).
# 비워두면 해당 종류는 푸시 없이 앱 안 알림만 남아요.
# 댓글·답글·소모임 댓글은 "새 댓글" 캠페인(TOSS_PUSH_TEMPLATE_COMMENT) 하나로 보내요(동의 화면 수 절감).
TOSS_PUSH_TEMPLATE_COMMENT=
TOSS_PUSH_TEMPLATE_DM=
TOSS_PUSH_TEMPLATE_BUNGAE_JOIN=
# 출시 전 테스트용: 콘솔에 올린 번들의 deploymentId를 넣으면 send-test-message로 보내요. 출시 후엔 비워요.
TOSS_PUSH_TEST_DEPLOYMENT_ID=

# --- 앱인토스 광고 (제공받은 운영 ID, 메뉴별로 광고그룹이 달라요) ---
# 배너: 수다방 글 상세(댓글 위) / 소모임 상세(참석 영역 위)
VITE_AD_BANNER_FEED_ID=
VITE_AD_BANNER_BUNGAE_ID=
